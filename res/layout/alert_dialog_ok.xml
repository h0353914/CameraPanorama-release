            <TextView android:id="@id/alert_dialog_body_text_2" android:layout_width="fill_parent" android:layout_height="wrap_content" android:paddingStart="@dimen/alert_dialog_padding_start" android:paddingEnd="@dimen/alert_dialog_padding_start" style="@style/AlertBodyTextStyle" />
        </LinearLayout>
