// Prebuilt JNI shared libraries for CameraPanorama

cc_prebuilt_library_shared {
    name: "libmorpho_memory_allocator_camerapanorama",
    stem: "libmorpho_memory_allocator",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libmorpho_memory_allocator.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libmorpho_jpeg_io_camerapanorama",
    stem: "libmorpho_jpeg_io",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libmorpho_jpeg_io.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libmorpho_panorama_gp2_camerapanorama",
    stem: "libmorpho_panorama_gp2",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libmorpho_panorama_gp2.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

cc_prebuilt_library_shared {
    name: "libmorpho_sensor_fusion_camerapanorama",
    stem: "libmorpho_sensor_fusion",
    srcs: ["app/src/main/jniLibs/arm64-v8a/libmorpho_sensor_fusion.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
    prefer: true,
}

// Compile-only stub JARs (compileOnly in Gradle)

java_import {
    name: "CameraPanorama-api-stubs",
    jars: ["app/libs/api-stubs.jar"],
    sdk_version: "current",
}

java_import {
    name: "CameraPanorama-extra-stubs",
    jars: ["app/libs/extra-stubs.jar"],
    sdk_version: "current",
}

// androidx 依賴：merged classes jar（見 app/build.gradle.kts 註解 — 用單一合併
// jar 而非個別 AAR 座標，避免 aapt2 對 res/values/public.xml 釘住的資源重新編號）

java_import {
    name: "CameraPanorama-androidx-classes",
    jars: ["app/libs/androidx-classes.jar"],
    sdk_version: "current",
}

// Main CameraPanorama application

android_app {
    name: "CameraPanorama-release",

    srcs: [
        "app/src/main/java/**/*.java",
    ],

    resource_dirs: ["app/src/main/res"],
    manifest: "app/src/main/AndroidManifest.xml",

    // Compile-only dependencies (not bundled at runtime)
    libs: [
        "CameraPanorama-api-stubs",
        "CameraPanorama-extra-stubs",
    ],

    // Bundled static dependencies
    static_libs: [
        "CameraPanorama-androidx-classes",
    ],

    platform_apis: true,
    certificate: "platform",
    privileged: true,
    // 對應 build.gradle.kts 的 minSdkVersion(35)；use_embedded_native_libs
    // 的判斷需要 min_sdk_version >= 23 才會生效（否則 Soong 仍會計算成
    // extractNativeLibs="true" 跟 manifest 既有屬性衝突）。
    min_sdk_version: "35",

    jni_libs: [
        "libmorpho_memory_allocator_camerapanorama",
        "libmorpho_jpeg_io_camerapanorama",
        "libmorpho_panorama_gp2_camerapanorama",
        "libmorpho_sensor_fusion_camerapanorama",
    ],

    // AndroidManifest.xml 明確宣告 extractNativeLibs="false"（現代 AGP 預設，
    // .so 未壓縮直接嵌入 APK），這裡要對應宣告，否則 Soong manifest_fixer
    // 會強制改成 extractNativeLibs="true" 跟既有 manifest 屬性衝突報錯。
    use_embedded_native_libs: true,

    optimize: {
        enabled: false,
    },

    // Disable <uses-library> enforcement - Sony-specific shared libraries
    // are not available in AOSP tree
    enforce_uses_libs: false,
}
